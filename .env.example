# ==========================================
# RadarStrike Environment Variables
# ==========================================

# Vercel AI Gateway (All LLM Routing & Failover)
# Obtain your key from Vercel Dashboard -> AI Gateway or via `vercel ai-gateway`
AI_GATEWAY_API_KEY=
AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1

# Tavily AI Search (Live Web Intelligence)
# Obtain key at https://tavily.com
TAVILY_API_KEY=

# MongoDB Atlas (Persistent Storage & Vector Search)
# Format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=radarstrike
